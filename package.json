{
  "name": "riftvoice",
  "version": "0.3.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "webpack",
    "build:prod": "webpack --mode production",
    "update-icons": "node scripts/update-champion-icons.js",
    "refresh-model": "node scripts/refresh-model.mjs",
    "train-model": "node scripts/refresh-model.mjs --skip-scrape",
    "test": "jest",
    "test:e2e": "npm --prefix server run build && jest --config jest.e2e.config.js",
    "test:all": "npm test && npm run test:e2e",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "build:windows": "tauri build --bundles nsis",
    "test:server": "npm --prefix server test -- --run",
    "verify": "npm run typecheck && npm test -- --runInBand --silent && npm run test:server && npm run test:e2e",
    "test:voice-audio": "node scripts/test-voice-audio.cjs",
    "test:organizer-ui": "node scripts/test-organizer-ui.cjs",
    "build:windows:caster": "tauri build --config src-tauri/tauri.caster.conf.json --bundles nsis"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "description": "Hybrid League of Legends voice with original real-time champion effects",
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.5",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^17.3.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "onnxruntime-web": "^1.24.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.5"
  }
}
